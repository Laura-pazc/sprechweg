# Copy this file to .env and fill in real values. .env is gitignored.

# OpenAI (ChatGPT) API key — do NOT prefix with EXPO_PUBLIC_, this must stay
# server-side only and never ship in the client bundle.
OPENAI_API_KEY=

# parse.bot scraper API key — sent as the `X-API-Key` header when calling
# https://api.parse.bot/scraper/... endpoints. Same rule: server-side only.
PARSE_BOT_API_KEY=

# Supabase project URL and anon/public key (Project Settings → API).
# These ARE safe to ship in the client — access is enforced by Row Level
# Security policies, not by keeping this key secret. Must be prefixed with
# EXPO_PUBLIC_ so Expo bundles them into the app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Rausgegangen events API key — do NOT prefix with EXPO_PUBLIC_. This never
# lives in the app; set it as a Supabase Edge Function secret instead
# (`supabase secrets set RAUSGEGANGEN_API_KEY=...`), never in this file.
