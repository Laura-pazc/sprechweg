# Copy this file to .env and fill in real values. .env is gitignored.

# OpenAI (ChatGPT) API key — do NOT prefix with EXPO_PUBLIC_, this must stay
# server-side only and never ship in the client bundle.
OPENAI_API_KEY=

# parse.bot scraper API key — sent as the `X-API-Key` header when calling
# https://api.parse.bot/scraper/... endpoints. Same rule: server-side only.
PARSE_BOT_API_KEY=
